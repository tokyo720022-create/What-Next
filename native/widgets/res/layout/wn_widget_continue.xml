<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/con_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wn_widget_bg" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/con_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold"/>
    <TextView android:id="@+id/con_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#FF9A9AA6" android:textSize="13sp" android:layout_marginTop="8dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/con_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/con_c1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/con_i1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop"/>
            <ProgressBar android:id="@+id/con_p1" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:max="100" android:progress="0" android:progressTint="#FF8B7CFF"/>
            <TextView android:id="@+id/con_t1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/con_s1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FF9A9AA6" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/con_c2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/con_i2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop"/>
            <ProgressBar android:id="@+id/con_p2" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:max="100" android:progress="0" android:progressTint="#FF8B7CFF"/>
            <TextView android:id="@+id/con_t2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/con_s2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FF9A9AA6" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/con_c3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/con_i3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop"/>
            <ProgressBar android:id="@+id/con_p3" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:max="100" android:progress="0" android:progressTint="#FF8B7CFF"/>
            <TextView android:id="@+id/con_t3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/con_s3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FF9A9AA6" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/con_c4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/con_i4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop"/>
            <ProgressBar android:id="@+id/con_p4" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:max="100" android:progress="0" android:progressTint="#FF8B7CFF"/>
            <TextView android:id="@+id/con_t4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/con_s4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FF9A9AA6" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
