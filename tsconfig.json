{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "moduleDetection": "legacy",
    "types": []
  },
  "include": ["js/**/*.js", "boot.js", "config.js", "types/*.d.ts"]
}
