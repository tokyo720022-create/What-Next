<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/con_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wn_widget_bg_glass" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/con_head" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="22sp" android:textStyle="bold"/>
        <ImageView android:id="@+id/con_hi" android:layout_width="30dp" android:layout_height="30dp" android:padding="2dp" android:src="@drawable/wn_check_circle" android:contentDescription="Open Pick"/>
    </LinearLayout>
    <TextView android:id="@+id/con_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#FFA0A0AC" android:textSize="13sp" android:layout_marginTop="8dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/con_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/con_c1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/con_i1" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitCenter"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:id="@+id/con_b1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/con_t1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/con_s1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFA0A0AC" android:textSize="12sp"/>
                </LinearLayout>
                <ImageView android:id="@+id/con_k1" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="4dp" android:padding="3dp" android:src="@drawable/wn_check" android:contentDescription="Mark the next episode as done"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/con_c2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/con_i2" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitCenter"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:id="@+id/con_b2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/con_t2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/con_s2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFA0A0AC" android:textSize="12sp"/>
                </LinearLayout>
                <ImageView android:id="@+id/con_k2" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="4dp" android:padding="3dp" android:src="@drawable/wn_check" android:contentDescription="Mark the next episode as done"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/con_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/con_c3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/con_i3" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitCenter"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:id="@+id/con_b3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/con_t3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/con_s3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFA0A0AC" android:textSize="12sp"/>
                </LinearLayout>
                <ImageView android:id="@+id/con_k3" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="4dp" android:padding="3dp" android:src="@drawable/wn_check" android:contentDescription="Mark the next episode as done"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/con_c4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/con_i4" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitCenter"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:id="@+id/con_b4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/con_t4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/con_s4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFA0A0AC" android:textSize="12sp"/>
                </LinearLayout>
                <ImageView android:id="@+id/con_k4" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="4dp" android:padding="3dp" android:src="@drawable/wn_check" android:contentDescription="Mark the next episode as done"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
